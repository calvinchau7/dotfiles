{
    "workbench.colorTheme": "Gruvbox Dark Hard",
    "claudeCode.useTerminal": true,
    "python.analysis.typeCheckingMode": "standard",
    "security.workspace.trust.untrustedFiles": "open",
    "explorer.confirmDelete": false,
    "zig.zls.enabled": "on",
    "git.autofetch": true,
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "workbench.iconTheme": "office-material-icon-theme",
    "workbench.experimental.modernUI": true,
    "editor.fontSize": 14,
    "editor.formatOnSave": true,
    "workbench.welcomePage.experimentalOnboarding": false,
    "workbench.startupEditor": "none",
    "python.languageServer": "Pylance",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.aiCodeActions": {
        "implementAbstractClasses": true,
        "generateSymbol": true,
        "convertFormatString": true
    },
    "editor.inlineSuggest.enabled": false,
    "zig.buildOnSaveProvider": "zls",
    "cmake.cacheInit": null,
    "cmake.additionalCompilerSearchDirs": [
        "C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/MSVC/14.51.36231/bin/Hostx64/x64"
    ],
    "terminal.integrated.allowedLinkSchemes": [
        "file",
        "http",
        "https",
        "mailto",
        "vscode",
        "vscode-insiders",
        "ms-settings"
    ],
    "lldb.suppressUpdateNotifications": true,
    "python.terminal.useEnvFile": true,
    "terminal.integrated.initialHint": false,
    "claudeCode.hideOnboarding": true,
    "js/ts.experimental.useTsgo": true,
    "vsicons.dontShowNewVersionMessage": true,
    "ols.prompt.AskCreateOLS": false,
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
}