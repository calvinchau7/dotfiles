[init]
	defaultBranch = main

# --- delta: nicer diffs for git diff / log -p / show / lazygit ---
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true        # n / N jump between files in a diff
	line-numbers = true
	hyperlinks = true
	syntax-theme = gruvbox-dark
[merge]
	conflictStyle = zdiff3

# --- small QoL defaults ---
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[diff]
	colorMoved = default
	algorithm = histogram
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
	gpgSign = true

# --- sign commits with your SSH key (add it on GitHub as a *signing* key) ---
[gpg]
	format = ssh
[user]
	signingkey = ~/.ssh/id_ed25519.pub
[commit]
	gpgSign = true
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
