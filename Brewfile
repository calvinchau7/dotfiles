# Packages for these dotfiles. Used by install.sh on macOS (and on Linux
# distros other than Arch, via Linuxbrew; casks are skipped there).
#   brew bundle --file=Brewfile

# shell + prompt
brew "fish"
brew "starship"
brew "fnm"
brew "zoxide"
brew "fzf"
brew "fastfetch"

# cli tools
brew "eza"
brew "bat"
brew "fd"
